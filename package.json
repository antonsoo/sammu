{
  "name": "@antonsoloviev/sammu",
  "version": "0.1.0",
  "private": true,
  "description": "Follow an ancient Mesopotamian retuning procedure, one string at a time.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/sammu.git"
  },
  "homepage": "https://antonsoo.github.io/sammu/",
  "keywords": [
    "mesopotamia",
    "music-theory",
    "akkadian",
    "tuning",
    "web-audio",
    "education"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4384 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4384 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:tuning": "node --import tsx scripts/tuning-cases.ts | python3 scripts/tuning-oracle.py",
    "test:browser": "node scripts/browser-review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
